# Terraform state — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Secret variable files — never commit
*.tfvars
!*.tfvars.example

# Sensitive override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# CLI config files
.terraformrc
terraform.rc

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo

# Keys
*.pem
*.key
id_rsa*
*.pub
vault.tfplan
*.tfplan
errored.tfstate
